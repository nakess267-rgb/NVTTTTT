@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');


/* =========================
   VARIABLES
========================= */

:root {
    --blue: #1769e0;
    --blue-dark: #0b3f9b;
    --blue-deep: #082f73;
    --blue-light: #eaf3ff;

    --text: #10213f;
    --muted: #66758a;

    --border: #dce7f5;

    --white: #ffffff;

    --green: #20ad72;
}


/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", Arial, sans-serif;
    color: var(--text);
    background: white;
    line-height: 1.6;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1160px, calc(100% - 48px));
    margin: auto;
}


/* =========================
   HEADER
========================= */

.header {
    height: 78px;
    background: rgba(255,255,255,.95);
    border-bottom: 1px solid #e5edf7;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(15px);
}

.nav {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-family: "Manrope", sans-serif;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo > span:last-child > span {
    color: var(--blue);
}

.logo-box {
    width: 36px;
    height: 36px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    color: white;

    background: linear-gradient(
        145deg,
        #3287f3,
        #0d51c0
    );

    box-shadow: 0 7px 18px rgba(23,105,224,.25);
}

.nav nav {
    display: flex;
}

nav {
    display: flex;
    align-items: center;
    gap: 31px;
    margin-left: auto;
}

nav a {
    color: #53637a;
    font-size: 14px;
    font-weight: 600;

    transition: .2s;
}

nav a:hover {
    color: var(--blue);
}

.nav-button {
    padding: 11px 17px;

    background: var(--blue);
    color: white;

    border-radius: 10px;

    font-size: 13px;
    font-weight: 700;

    box-shadow: 0 8px 20px rgba(23,105,224,.2);

    transition: .2s;
}

.nav-button:hover {
    transform: translateY(-2px);
}


/* =========================
   HERO
========================= */

.hero {
    position: relative;
    overflow: hidden;

    min-height: 680px;

    background:
        linear-gradient(
            120deg,
            #ffffff 0%,
            #f8fbff 48%,
            #edf5ff 100%
        );
}

.hero-background {
    position: absolute;
    inset: 0;

    opacity: .45;

    background-image:
        linear-gradient(
            rgba(23,105,224,.07) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(23,105,224,.07) 1px,
            transparent 1px
        );

    background-size: 55px 55px;

    mask-image:
        linear-gradient(
            to right,
            black,
            transparent 80%
        );
}

.hero-content {
    min-height: 680px;

    display: grid;
    grid-template-columns: 1.02fr .98fr;

    align-items: center;

    gap: 30px;

    position: relative;
}

.hero-text {
    max-width: 620px;

    position: relative;
    z-index: 2;
}

.eyebrow,
.tag {
    color: var(--blue);

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 1.5px;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
}

.eyebrow span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #20b477;

    box-shadow:
        0 0 0 5px rgba(32,180,119,.12);
}

.hero h1 {
    margin: 22px 0 25px;

    font-family: "Manrope", sans-serif;

    font-size: clamp(46px, 5.2vw, 74px);
    line-height: 1.02;

    letter-spacing: -3.8px;
    font-weight: 800;
}

.hero h1 strong {
    display: block;
    color: var(--blue);
}

.hero-text > p {
    max-width: 550px;

    color: var(--muted);

    font-size: 17px;
}

.hero-buttons {
    display: flex;
    gap: 12px;

    margin-top: 32px;

    flex-wrap: wrap;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 12px;

    padding: 14px 20px;

    border-radius: 10px;

    font-size: 13px;
    font-weight: 700;

    transition: .2s;
}

.button:hover {
    transform: translateY(-2px);
}

.primary {
    color: white;
    background: var(--blue);

    box-shadow:
        0 12px 25px rgba(23,105,224,.22);
}

.secondary {
    color: var(--blue-dark);
    background: white;

    border: 1px solid var(--border);
}

.trust {
    display: flex;
    align-items: center;

    gap: 13px;

    margin-top: 42px;
}

.trust-circles {
    display: flex;
}

.trust-circles span {
    width: 31px;
    height: 31px;

    margin-left: -7px;

    border: 2px solid white;
    border-radius: 50%;

    display: grid;
    place-items: center;

    background: var(--blue-light);
    color: var(--blue);

    font-size: 8px;
    font-weight: 800;
}

.trust-circles span:first-child {
    margin-left: 0;

    background: var(--blue);
    color: white;
}

.trust strong,
.trust small {
    display: block;
}

.trust strong {
    font-size: 12px;
}

.trust small {
    color: #8794a6;
    font-size: 11px;
}


/* =========================
   HERO DASHBOARD
========================= */

.hero-dashboard {
    height: 530px;

    display: grid;
    place-items: center;

    position: relative;
}

.dashboard {
    width: min(430px, 86%);

    padding: 24px;

    background: rgba(255,255,255,.96);

    border: 1px solid #d8e5f6;

    border-radius: 22px;

    box-shadow:
        0 35px 75px rgba(26,73,134,.16),
        0 4px 15px rgba(35,82,145,.06);

    position: relative;
    z-index: 2;
}

.dashboard-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.dashboard-header small {
    color: #8b9ab0;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.2px;
}

.dashboard-header h3 {
    margin-top: 3px;

    font-family: "Manrope", sans-serif;

    font-size: 20px;
}

.online {
    padding: 6px 9px;

    background: #e8faf2;

    border-radius: 20px;

    color: #209866;

    font-size: 10px;
    font-weight: 700;
}

.online span {
    display: inline-block;

    width: 5px;
    height: 5px;

    margin-right: 5px;

    border-radius: 50%;

    background: #25b879;
}


/* Network */

.network {
    height: 245px;

    margin: 13px 0 8px;

    border-radius: 15px;

    position: relative;

    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            #f4f8ff,
            #e9f3ff
        );
}

.network-grid {
    position: absolute;
    inset: 0;

    background-image:
        radial-gradient(
            #b9d3f5 1px,
            transparent 1px
        );

    background-size: 17px 17px;

    opacity: .6;
}

.network-line {
    position: absolute;

    width: 70%;
    height: 1px;

    background: #b6d2f5;

    left: 15%;
    top: 50%;
}

.line1 {
    transform: rotate(35deg);
}

.line2 {
    transform: rotate(-35deg);
}

.line3 {
    transform: rotate(90deg);
}

.network-node {
    position: absolute;

    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    background: white;

    border: 1px solid #cfe0f6;

    border-radius: 12px;

    color: var(--blue);

    box-shadow:
        0 7px 17px rgba(35,90,155,.1);

    z-index: 2;
}

.node1 {
    left: 24px;
    top: 34px;
}

.node2 {
    right: 28px;
    top: 40px;
}

.node3 {
    left: 44px;
    bottom: 27px;
}

.node4 {
    right: 47px;
    bottom: 22px;
}

.network-center {
    position: absolute;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    width: 112px;
    height: 112px;

    border-radius: 50%;

    background: white;

    border: 8px solid #dcecff;

    display: grid;
    place-items: center;
    align-content: center;

    box-shadow:
        0 10px 30px rgba(31,94,170,.12);
}

.network-center strong {
    color: var(--blue);

    font-family: "Manrope", sans-serif;

    font-size: 22px;
}

.network-center span {
    color: #8795a8;
    font-size: 9px;
}


/* Metrics */

.metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    border-top: 1px solid #edf1f7;

    padding-top: 16px;
}

.metrics small,
.metrics strong {
    display: block;
}

.metrics small {
    color: #8b99aa;
    font-size: 9px;
}

.metrics strong {
    margin-top: 2px;

    font-family: "Manrope", sans-serif;

    font-size: 16px;
}

.metrics .green {
    color: var(--green);
}


/* Floating */

.floating {
    position: absolute;

    z-index: 5;

    display: flex;
    align-items: center;

    gap: 9px;

    padding: 11px 13px;

    background: white;

    border: 1px solid var(--border);

    border-radius: 13px;

    box-shadow:
        0 18px 35px rgba(35,82,145,.13);
}

.floating small,
.floating strong {
    display: block;
}

.floating small {
    color: #8795a8;
    font-size: 8px;
}

.floating strong {
    font-size: 10px;
}

.ticket {
    left: 3%;
    bottom: 72px;
}

.security {
    right: 0;
    top: 96px;
}

.floating-icon {
    width: 31px;
    height: 31px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    font-weight: 800;
}

.green-icon {
    background: #e9f8f1;
    color: #1ba26c;
}

.blue-icon {
    background: #eaf3ff;
    color: var(--blue);
}


/* =========================
   CLIENT BAR
========================= */

.client-bar {
    border-top: 1px solid #edf2f8;
    border-bottom: 1px solid #edf2f8;
}

.clients {
    min-height: 92px;

    display: flex;
    align-items: center;

    gap: 55px;
}

.clients > span {
    color: #a0acbb;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.4px;
}

.clients > div {
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    color: #9caabd;
}

.clients strong {
    font-family: "Manrope", sans-serif;

    font-size: 14px;
    letter-spacing: 1px;
}

.clients strong span {
    color: var(--blue);
}


/* =========================
   SECTIONS
========================= */

.section {
    padding: 105px 0;
}

.section-heading {
    display: grid;
    grid-template-columns: 1fr .72fr;

    gap: 70px;

    align-items: end;

    margin-bottom: 55px;
}

.section-heading h2,
.about-text h2,
.center-heading h2,
.cta h2 {
    margin-top: 12px;

    font-family: "Manrope", sans-serif;

    font-size: clamp(35px, 4vw, 53px);

    line-height: 1.08;

    letter-spacing: -2.5px;
}

.section-heading h2 span,
.about-text h2 span,
.center-heading h2 span {
    color: var(--blue);
}

.section-heading > p {
    max-width: 450px;

    color: var(--muted);

    font-size: 15px;
}


/* =========================
   SERVICES
========================= */

.services {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 16px;
}

.service {
    min-height: 335px;

    padding: 28px 25px;

    border: 1px solid var(--border);

    border-radius: 17px;

    background: white;

    position: relative;

    overflow: hidden;

    transition: .25s;
}

.service:hover {
    transform: translateY(-6px);

    border-color: #bdd6f5;

    box-shadow:
        0 20px 40px rgba(22,78,145,.1);
}

.service.featured {
    color: white;

    background:
        linear-gradient(
            145deg,
            #1769e0,
            #0b4eae
        );

    border: 0;

    box-shadow:
        0 20px 40px rgba(23,105,224,.2);
}

.number {
    position: absolute;

    right: 20px;
    top: 22px;

    font-family: "Manrope", sans-serif;

    font-size: 10px;
    font-weight: 700;

    opacity: .45;
}

.service-icon {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    margin-bottom: 55px;

    border-radius: 13px;

    background: #eaf3ff;

    color: var(--blue);

    font-size: 23px;
}

.featured .service-icon {
    background: rgba(255,255,255,.15);
    color: white;
}

.service h3 {
    margin-bottom: 10px;

    font-family: "Manrope", sans-serif;

    font-size: 19px;
}

.service p {
    color: #708097;

    font-size: 12px;

    line-height: 1.7;
}

.featured p {
    color: #d7e7ff;
}

.service a {
    position: absolute;

    bottom: 25px;

    color: var(--blue);

    font-size: 11px;
    font-weight: 800;
}

.featured a {
    color: white;
}


/* =========================
   ABOUT
========================= */

.about {
    background: #f6f9fe;
}

.about-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 95px;

    align-items: center;
}

.about-visual {
    height: 475px;

    position: relative;
}

.blue-panel {
    position: absolute;

    inset: 0 45px 35px 0;

    padding: 36px;

    overflow: hidden;

    border-radius: 25px;

    color: white;

    background:
        linear-gradient(
            145deg,
            #166be5,
            #0b3e95
        );

    box-shadow:
        0 25px 55px rgba(15,67,145,.2);
}

.panel-grid {
    position: absolute;

    inset: 0;

    opacity: .17;

    background-image:
        linear-gradient(#fff 1px, transparent 1px),
        linear-gradient(90deg,#fff 1px,transparent 1px);

    background-size: 35px 35px;

    transform:
        perspective(500px)
        rotateX(45deg)
        scale(1.4);

    transform-origin: bottom;
}

.panel-circle {
    position: absolute;

    right: 30px;
    top: 30px;

    width: 108px;
    height: 108px;

    display: grid;
    place-items: center;
    align-content: center;

    text-align: center;

    border-radius: 50%;

    background: rgba(255,255,255,.1);

    border: 1px solid rgba(255,255,255,.2);

    z-index: 2;
}

.panel-circle strong {
    font-family: "Manrope", sans-serif;
    font-size: 19px;
}

.panel-circle small {
    font-size: 8px;
    opacity: .7;
}

.panel-text {
    position: absolute;

    left: 36px;
    bottom: 45px;

    max-width: 260px;

    z-index: 2;
}

.panel-text small {
    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.4px;

    opacity: .7;
}

.panel-text h3 {
    margin-top: 8px;

    font-family: "Manrope", sans-serif;

    font-size: 25px;
    line-height: 1.2;
}

.experience {
    position: absolute;

    right: 0;
    bottom: 0;

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 20px 24px;

    background: white;

    border-radius: 15px;

    box-shadow:
        0 18px 40px rgba(22,62,115,.15);
}

.experience strong {
    color: var(--blue);

    font-family: "Manrope", sans-serif;

    font-size: 31px;
}

.experience span {
    color: #7a879a;

    font-size: 10px;

    line-height: 1.35;
}

.about-text > p {
    max-width: 500px;

    margin: 25px 0 28px;

    color: var(--muted);

    font-size: 15px;
}

.check-list {
    display: grid;

    gap: 17px;
}

.check-list > div {
    display: flex;

    gap: 13px;

    align-items: flex-start;
}

.check-list > div > span {
    width: 23px;
    height: 23px;

    flex: none;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #e6f2ff;

    color: var(--blue);

    font-size: 11px;
    font-weight: 800;
}

.check-list strong,
.check-list small {
    display: block;
}

.check-list strong {
    font-size: 13px;
}

.check-list small {
    margin-top: 1px;

    color: #8190a3;

    font-size: 11px;
}

.learn-link {
    display: inline-flex;

    gap: 10px;

    margin-top: 31px;

    color: var(--blue);

    font-size: 12px;
    font-weight: 800;
}


/* =========================
   STATS
========================= */

.stats {
    padding: 55px 0;

    background: var(--blue-dark);

    color: white;
}

.stats-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);
}

.stats-grid > div {
    padding: 0 35px;

    border-right: 1px solid rgba(255,255,255,.16);
}

.stats-grid > div:first-child {
    padding-left: 0;
}

.stats-grid > div:last-child {
    border: 0;
}

.stats strong {
    display: block;

    font-family: "Manrope", sans-serif;

    font-size: 40px;

    letter-spacing: -2px;
}

.stats strong span {
    color: #78b1ff;
}

.stats small {
    color: #c1d7f7;

    font-size: 10px;
}


/* =========================
   SOLUTIONS
========================= */

.center-heading {
    max-width: 680px;

    margin: 0 auto 55px;

    text-align: center;
}

.center-heading p {
    margin-top: 18px;

    color: var(--muted);

    font-size: 14px;
}

.solution-grid {
    display: grid;

    grid-template-columns: 1.25fr .75fr .75fr;

    gap: 16px;
}

.solution {
    min-height: 420px;

    padding: 28px;

    position: relative;

    overflow: hidden;

    border: 1px solid var(--border);

    border-radius: 20px;

    background: #f8fbff;
}

.solution.large {
    background:
        linear-gradient(
            145deg,
            #eaf3ff,
            #f7fbff
        );
}

.solution-top {
    display: flex;

    justify-content: space-between;

    color: #8291a5;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.2px;
}

.solution h3 {
    margin-top: 30px;

    font-family: "Manrope", sans-serif;

    font-size: 25px;

    line-height: 1.15;

    letter-spacing: -1px;
}

.solution p {
    max-width: 310px;

    margin-top: 13px;

    color: #718096;

    font-size: 12px;
}

.chart {
    height: 125px;

    position: absolute;

    left: 28px;
    right: 28px;
    bottom: 0;

    display: flex;

    align-items: flex-end;

    gap: 9px;
}

.chart i {
    flex: 1;

    border-radius: 7px 7px 0 0;

    background:
        linear-gradient(
            to top,
            #2478e9,
            #a9d0ff
        );

    opacity: .75;
}

.security-symbol {
    width: 82px;
    height: 82px;

    margin-top: 55px;

    display: grid;
    place-items: center;

    border-radius: 22px;

    background: white;

    color: var(--blue);

    font-size: 38px;

    box-shadow:
        0 15px 30px rgba(30,91,160,.1);
}

.support-list {
    display: grid;

    gap: 7px;

    margin-top: 50px;
}

.support-list div {
    display: flex;

    justify-content: space-between;

    padding: 9px 10px;

    background: white;

    border: 1px solid #e4edf8;

    border-radius: 8px;

    color: #66758a;

    font-size: 9px;
}

.support-list div {
    color: #20a36d;
}

.support-list span {
    color: #20a36d;
}


/* =========================
   CTA
========================= */

.cta {
    padding: 82px 0;

    position: relative;

    overflow: hidden;

    color: white;

    background:
        linear-gradient(
            120deg,
            #1769e0,
            #0b439f
        );
}

.cta-content {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 40px;

    position: relative;

    z-index: 2;
}

.cta h2 {
    color: white;
}

.cta h2 span {
    color: #9ccaff;
}

.cta p {
    margin-top: 16px;

    color: #d3e5ff;

    font-size: 14px;
}

.cta .tag {
    color: #b8d8ff;
}

.white {
    color: var(--blue);

    background: white;

    box-shadow:
        0 15px 30px rgba(3,36,91,.14);

    white-space: nowrap;
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 70px 0 25px;

    background: #f7faff;
}

.footer-grid {
    display: grid;

    grid-template-columns: 2fr 1fr 1fr 1.5fr;

    gap: 45px;

    padding-bottom: 55px;
}

.footer-grid p {
    margin-top: 16px;

    color: #7b8ba1;

    font-size: 11px;

    line-height: 1.7;
}

.footer-grid h4 {
    margin-bottom: 18px;

    font-family: "Manrope", sans-serif;

    font-size: 12px;
}

.footer-grid a,
.footer-grid div:last-child span {
    display: block;

